# Production analytics (GoatCounter). Публичный site code, НЕ секрет.
#
# Production site code проекта зафиксирован в src/lib/analytics.ts:
#   DEFAULT_SITE_CODE = 'kudriashovsv'
#   endpoint → https://kudriashovsv.goatcounter.com/count
#
# Так GitHub Pages build (npm run build в Actions, без env/секретов) всегда
# содержит аналитику и не требует ручной настройки на каждом деплое.
#
# VITE_GOATCOUNTER_CODE — необязательный override (например, для тестовой сборки):
# если задать непустое значение, оно заменит site code по умолчанию.
#
# В dev-режиме аналитика выключена (import.meta.env.PROD === false), поэтому
# локальная разработка не отправляет реальные события.
VITE_GOATCOUNTER_CODE=
